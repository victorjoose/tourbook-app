{
  "name": "tour-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "emulators": "firebase emulators:start --only auth,firestore",
    "rules:test": "firebase emulators:exec --only firestore \"vitest run --root firebase\"",
    "rules:deploy": "firebase deploy --only firestore:rules,firestore:indexes",
    "seed": "tsx scripts/seed.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "tsx": "^4.23.15"
  }
}
